        "shadow_distance": 5,
        "shadow_angle": -45
      },
      "ass": {
        "font_size": 12,
        "outline": 3.5,
        "shadow": 5,
        "x_shadow": -4,
        "y_shadow": -4,
        "position": {
          "x": 540,
          "y": 1320
        }
      }
    },
    "1728x3072": {
