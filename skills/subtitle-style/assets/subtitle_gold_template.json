{
  "template_name": "字幕基础模板",
  "version": "1.0",
  "assumptions": {
    "distance_unit": "px",
    "source_shadow_distance": 5,
    "source_shadow_angle": -45,
    "source_shadow_opacity": 0.7,
    "source_blur": 0.15
  },
  "common_style": {
    "font": "金陵体",
    "font_color": "#FFFFFF",
    "alignment": "center",
    "scale_x": 100,
    "scale_y": 100,
    "shadow_color": "#000000",
    "shadow_opacity": 0.7,
    "shadow_angle": -45,
    "ass_shadow_color": "&H4D000000",
    "ass_primary_color": "&H00FFFFFF",
    "ass_outline_color": "&H00000000",
    "ass_border_style": 1
  },
  "resolutions": {
    "1080x1920": {
      "width": 1080,
      "height": 1920,
      "scale": 1,
