# ============================================================
# 抖音账号数据复盘 Skill —— 环境变量样例
# 复制为 .env（或直接写进 systemd / 定时任务的 Environment）
# 配置文件中用 ${VAR} 引用，缺失必填变量会直接报错退出。
# ============================================================

# ---- PostgreSQL（193 服务器） ----
DYREVIEW_DB_DSN=postgresql://dyreview:CHANGE_ME@193.0.0.193:5432/renwei
# 可选：连接参数覆盖
# DYREVIEW_DB_SSLMODE=prefer

# ---- Token 落库加密（强烈建议生产开启） ----
# 生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DYREVIEW_TOKEN_KEY=
# 轮换时把旧 key 放这里，实现平滑解密
DYREVIEW_TOKEN_KEY_PREVIOUS=

# ---- 抖音开放平台应用 ----
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=

# ---- 飞书自建应用 ----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 默认回推群/会话（oc_ 开头为群 chat_id，ou_ 开头需先创建单聊）
FEISHU_DEFAULT_CHAT_ID=
# 可选：群自定义机器人 webhook（无应用权限时兜底推送）
FEISHU_WEBHOOK_URL=

# ---- 大模型（llm.mode=builtin 时必填；handoff 模式交给 Crabot 则可不填） ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- 配置文件路径（可选，默认 config/config.yaml） ----
# DYREVIEW_CONFIG=config/config.yaml

# ---- 日志级别 ----
DYREVIEW_LOG_LEVEL=INFO
